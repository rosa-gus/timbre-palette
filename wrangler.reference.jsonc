{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "timbre-palette-api-server-assembly-reference-local-only",
  "main": "src/worker.py",
  "compatibility_date": "2026-09-07",
  "compatibility_flags": ["python_workers"],
  "workers_dev": false,
  "rules": [
    {
      "type": "Text",
      "globs": ["**/_generated_image_catalog.json", "**/_curated_example_history.json"],
      "fallthrough": true
    }
  ],
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 }
  },
  "cache": {
    "enabled": true,
    "cross_version_cache": false
  },
  "vars": {
    "IMAGE_ASSET_BASE_URL": "https://rosa-gus.github.io/timbre-palette/"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "timbre-palette",
      "database_id": "32fa319e-eeb6-4b3b-b981-ddcc92d75605",
      "migrations_dir": "migrations"
    }
  ]
}
