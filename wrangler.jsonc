{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "timbre-palette-api",
  "main": "workers/api/src/index.ts",
  "build": {
    "command": "yarn prepare:images",
    "watch_dir": ["catalog", "assets/treated", "scripts"]
  },
  "compatibility_date": "2026-09-18",
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  },
  "cache": {
    "enabled": true,
    "cross_version_cache": false
  },
  "vars": {
    "IMAGE_ASSET_BASE_URL": "https://rosa-gus.github.io/timbre-palette/"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "timbre-palette",
      "database_id": "32fa319e-eeb6-4b3b-b981-ddcc92d75605",
      "migrations_dir": "migrations"
    }
  ]
}
