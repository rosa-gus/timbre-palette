{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "timbre-palette-api",
  "main": "src/worker.py",
  // Keep Python Workers on the stable 3.13 runtime until the 3.14 Pyodide
  // promising-task initialization issue is resolved upstream.
  "compatibility_date": "2026-09-07",
  "compatibility_flags": ["python_workers"],
  "rules": [
    {
      "type": "Text",
      "globs": ["**/_generated_image_catalog.json"],
      "fallthrough": true
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    }
  },
  "cache": {
    "enabled": true,
    "cross_version_cache": false
  },
  "vars": {
    "IMAGE_ASSET_BASE_URL": "https://rosa-gus.github.io/timbre-palette/"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "timbre-palette",
      "database_id": "32fa319e-eeb6-4b3b-b981-ddcc92d75605",
      "migrations_dir": "migrations"
    }
  ]
}
