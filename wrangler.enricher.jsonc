{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "timbre-palette-enricher",
  "main": "src/enrichment_queue_worker.ts",
  "compatibility_date": "2026-09-07",
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    }
  },
  "services": [
    {
      "binding": "ENRICHER",
      "service": "timbre-palette-enricher-python"
    }
  ],
  "queues": {
    "consumers": [
      {
        "queue": "timbre-palette-enrichment",
        "max_batch_size": 1,
        "max_batch_timeout": 0,
        "max_retries": 3,
        "dead_letter_queue": "timbre-palette-enrichment-dlq",
        "max_concurrency": 1
      },
      {
        "queue": "timbre-palette-enrichment-dlq",
        "max_batch_size": 1,
        "max_batch_timeout": 0,
        "max_retries": 5,
        "max_concurrency": 1
      }
    ]
  }
}
