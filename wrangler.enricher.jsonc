{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "timbre-palette-enricher",
  "main": "src/enrichment_worker.py",
  // Keep Python Workers on the stable 3.13 runtime until the 3.14 Pyodide
  // promising-task initialization issue is resolved upstream.
  "compatibility_date": "2026-09-07",
  "compatibility_flags": ["python_workers"],
  "vars": {
    "MUSICBRAINZ_USER_AGENT": "timbre-palette-api/0.3.1 (rosagus.contato@protonmail.com)"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "timbre-palette",
      "database_id": "de217b93-15a0-45be-802d-c9966582d66a",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  },
  "queues": {
    "producers": [
      {
        "binding": "ENRICHMENT_QUEUE",
        "queue": "timbre-palette-enrichment"
      }
    ],
    "consumers": [
      {
        "queue": "timbre-palette-enrichment",
        "max_batch_size": 1,
        "max_batch_timeout": 0,
        "max_retries": 5,
        "dead_letter_queue": "timbre-palette-enrichment-dlq",
        "max_concurrency": 1
      },
      {
        "queue": "timbre-palette-enrichment-dlq",
        "max_batch_size": 1,
        "max_batch_timeout": 0,
        "max_retries": 5,
        "max_concurrency": 1
      }
    ]
  }
}
